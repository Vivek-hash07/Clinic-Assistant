// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  patient      Patient?
}

model Patient {
  id           String        @id @default(cuid())
  userId       String        @unique
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name             String
  dob              DateTime          @db.Date
  appointments     Appointment[]
  conversationLogs ConversationLog[]
  chatThreads      ChatThread[]
}

/// One sidebar conversation. Messages stay on this row; ConversationLog remains the eval transcript.
model ChatThread {
  id        String   @id @default(cuid())
  patientId String
  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  title     String
  messages  Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([patientId, updatedAt])
}

enum AppointmentStatus {
  scheduled
  cancelled
  completed
}

model Appointment {
  id        String            @id @default(cuid())
  patientId String
  patient   Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor    String
  datetime  DateTime
  status    AppointmentStatus
  reason    String

  @@index([patientId])
  @@index([doctor, datetime])
}

/// Full agent turns for eval and debugging. Mem0 stores the curated memory separately.
model ConversationLog {
  id               String   @id @default(cuid())
  patientId        String
  patient          Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  createdAt        DateTime @default(now())
  userMessage      String
  assistantMessage String
  transcript       Json

  @@index([patientId, createdAt])
}
